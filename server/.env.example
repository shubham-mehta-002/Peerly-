PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Gmail sender (must be verified in Brevo → Senders, domains & IPs → Senders)
GMAIL_USER=your_gmail@gmail.com

# Brevo HTTP API (works on Render — no SMTP ports needed)
# brevo.com → SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=your_brevo_api_key

# Redis — Upstash (upstash.com → your database → Details tab → Redis URL)
REDIS_URL=rediss://default:your_password@your-host.upstash.io:6379

# Seed data
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your_admin_password
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Admin Name
SEED_COLLEGE_NAME=Your College Name
SEED_CAMPUS_NAME=Your Campus
SEED_DOMAIN=yourcollege.edu
