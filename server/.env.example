PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Gmail sender address (must be verified in Brevo → Senders, domains & IPs → Senders)
GMAIL_USER=your_gmail@gmail.com

# Brevo SMTP relay (transactional email — works on Render)
# Sign up at brevo.com → SMTP & API → SMTP tab → copy login + generate key
BREVO_SMTP_USER=your_brevo_account_email@example.com
BREVO_SMTP_KEY=your_brevo_smtp_key

# Redis — Upstash (upstash.com → your database → Details tab → Redis URL)
REDIS_URL=rediss://default:your_password@your-host.upstash.io:6379
